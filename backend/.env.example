# Copy to .env and fill in real values. Never commit the real .env.

# --- Database (Postgres) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/telefam
DATABASE_USER=telefam_app
DATABASE_PASSWORD=change_me
DATABASE_POOL_SIZE=10

# --- JWT ---
JWT_ACCESS_SECRET=generate_a_long_random_64_byte_secret
JWT_REFRESH_SECRET=generate_a_different_long_random_64_byte_secret
JWT_ISSUER=telefam
JWT_AUDIENCE=telefam-users
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Google Sign-In (real console values) ---
GOOGLE_CLIENT_ID_ANDROID=your-android-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-oauth-client-id.apps.googleusercontent.com

# --- Apple Sign In (real Services ID) ---
APPLE_CLIENT_ID=com.telefam.app
APPLE_KEYS_URL=https://appleid.apple.com/auth/keys
APPLE_ISSUER=https://appleid.apple.com

# --- Resend (email delivery, OTP + transactional) ---
RESEND_API_KEY=re_your_real_api_key
RESEND_FROM_ADDRESS=Telefam <no-reply@telefam.app>

# --- Media (isolated storage root, sandboxed processing) ---
MEDIA_STORAGE_PATH=/var/telefam/media
MEDIA_MAX_UPLOAD_BYTES=8388608
MEDIA_MAX_DIMENSION=1600

# --- Security thresholds ---
MAX_LOGIN_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=30
MAX_OTP_ATTEMPTS=5
OTP_COOLDOWN_HOURS=5
OTP_RESEND_INTERVAL_SECONDS=60
OTP_RESEND_MAX_COUNT=5
OTP_TTL_MINUTES=10

PORT=8080
MEDIA_BLOB_MAX_BYTES=33554432

# --- Post video pipeline ---
POST_MAX_UPLOAD_BYTES=104857600
POST_CHUNK_SIZE_BYTES=4194304
POST_QUARANTINE_PATH=/var/telefam/quarantine
POST_WORK_PATH=/var/telefam/work
POST_PUBLIC_STORAGE_PATH=/var/telefam/public-media
POST_SIGNING_SECRET=generate_another_long_random_secret
POST_SIGNED_URL_TTL_SECONDS=300
POST_WORKER_COUNT=2
POST_MAX_DURATION_MS=600000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Feeds / CDN ---
# Optional: mint signed media URLs on your CDN origin (must validate the same HMAC). Leave empty to serve via app.
CDN_BASE_URL=
# Public web base for shareable post links
PUBLIC_BASE_URL=https://telefam.app
FEED_PAGE_SIZE=10

# --- Payments ---
PAYSTACK_SECRET_KEY=sk_live_...
# Required to enable Paystack automatic renewals. Generate 32 random bytes, then base64-encode them.
# Keep this secret stable; changing it makes stored renewal authorizations unreadable.
PAYMENT_TOKEN_ENCRYPTION_KEY=
SUBSCRIPTION_BILLING_GRACE_DAYS=7
SUBSCRIPTION_MAX_RENEWAL_RETRIES=3
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com  # sandbox while testing

# --- Verification (server-side AI document review) ---
KIMI_API_KEY=sk-...
# KIMI_MODEL=moonshot-v1-32k-vision-preview
VERIFICATION_BADGE_TTL_DAYS=365
VERIFICATION_BILLING_GRACE_DAYS=7
VERIFICATION_REFUND_DAYS=3
LIVENESS_CHALLENGE_SECRET=  # openssl rand -hex 64

# --- Wallet ---
SETTLEMENT_PERIOD_HOURS=72
SETTLEMENT_SWEEP_SECONDS=60
PLATFORM_FEE_PERCENT=20
MIN_WITHDRAWAL_MINOR=1000
SUBSCRIPTION_REFUND_WINDOW_MINUTES=15
# openssl rand -base64 32  (encrypts payout-method details at rest)
PAYOUT_DETAIL_ENCRYPTION_KEY=
# openssl rand -hex 64  (HMAC for payout-provider webhooks)
PAYOUT_WEBHOOK_SECRET=

# --- Calls (WebRTC P2P; media NEVER crosses this server) ---
# TURN relay for restrictive NATs (coturn/Twilio/Metered). Empty = STUN-only.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Firebase Cloud Messaging v1 — wakes the callee's device (locked/backgrounded/killed app).
# Leave empty to disable pushes (calls then only ring while the app is open).
FCM_PROJECT_ID=
# Full service-account JSON on a single line (used to mint FCM access tokens).
FCM_SERVICE_ACCOUNT_JSON=
# iOS bundle id — used to build the .voip APNs topic for CallKit pushes.
IOS_BUNDLE_ID=com.telefam.app
