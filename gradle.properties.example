# Copy to gradle.properties (or export as real environment variables in CI) — never commit real values.

# Used by androidApp/build.gradle.kts BuildConfig fields.
API_BASE_URL=https://api.telefam.app
GOOGLE_CLIENT_ID_WEB=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-oauth-client-id.apps.googleusercontent.com

org.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8
kotlin.code.style=official
android.useAndroidX=true
GIPHY_API_KEY=your-giphy-api-key
